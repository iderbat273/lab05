{
  "info": {
    "name": "Lab 05 - Course Registration API Tests",
    "description": "Independent registration API tests for F.CSA313 Lab 5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Successful registration",
      "item": [
        {
          "name": "Setup student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/STU01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "STU01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS101\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup request returns HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/COURSE01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "COURSE01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS101\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup request returns HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"STU01\",\"courseID\":\"COURSE01\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"result is OK\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });",
                  "pm.test(\"registrationID is a number\", function () { pm.expect(pm.response.json().registrationID).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
